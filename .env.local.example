# ============================================================
# Convix — CRM para WhatsApp · H&M Business
# Corre contra cualquier PostgreSQL y cualquier servidor Node.
# REQUERIDAS — la app no arranca sin estas.
# ============================================================

# PostgreSQL (>= 14; pgvector opcional para búsqueda semántica).
# El usuario debe ser el dueño del esquema (el que corre las
# migraciones) y tener CREATEROLE la primera vez (se crea el rol
# sin login `convix_user` que aplica RLS a las consultas de usuario).
#   docker compose up -d db   # levanta uno listo para usar
#   npm run db:migrate        # aplica db/migrations/*
DATABASE_URL=postgres://postgres:postgres@localhost:5432/convix
# DATABASE_SSL=true           # para Postgres gestionado con TLS
# DATABASE_POOL_MAX=10

# Cifrado de tokens de WhatsApp (64 hex chars = 32 bytes, AES-256-GCM).
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotarlo deja huérfano todo token cifrado con la clave anterior.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifica la firma HMAC-SHA256 de cada webhook entrante.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMENDADAS
# ============================================================

# URL pública canónica del despliegue (sin slash final). Se usa para
# el sitemap, OG images, enlaces de reseteo de contraseña y el
# redirect_uri de OIDC detrás de un proxy.
NEXT_PUBLIC_SITE_URL=https://crm.convix.one

# Idioma por defecto (p.ej. en, es)
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# STORAGE DE ARCHIVOS (avatares, media de chat y de flujos)
# ============================================================
# local (default): disco en STORAGE_LOCAL_PATH (./data/storage).
# s3: MinIO / AWS S3 / Cloudflare R2 — estándar del ecosistema H&M.
# Las URLs públicas siempre son /api/storage/<bucket>/<path>.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=./data/storage
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=convix
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

# ============================================================
# SSO OIDC (opcional) — Vaultex/Keycloak del ecosistema H&M
# Business, o cualquier proveedor OIDC estándar. Sin esto la app
# funciona con email/contraseña.
# ============================================================
# OIDC_ISSUER_URL=http://localhost:8080/realms/convix
# OIDC_CLIENT_ID=convix
# OIDC_CLIENT_SECRET=...
# OIDC_PROVIDER_NAME=Vaultex

# ============================================================
# SMTP (opcional) — emails de reseteo de contraseña.
# En dev, Mailpit: SMTP_HOST=localhost SMTP_PORT=1025.
# Sin SMTP el enlace de reseteo se loguea en el servidor.
# ============================================================
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Convix <no-reply@crm.convix.one>"

# ============================================================
# EVENTOS DEL ECOSISTEMA (opcional) — Kafka compartido de H&M
# Business. Cada evento de dominio se publica en `convix.<evento>`
# (message.received, message.status_updated, conversation.created),
# con el account_id como clave. Sin KAFKA_BROKERS es un no-op.
# ============================================================
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=convix
# KAFKA_TOPIC_PREFIX=convix

# ============================================================
# OPCIONALES — solo si usas la función.
# ============================================================

# Allow-list de hostnames para los enlaces de invitación (defensa
# extra cuando NEXT_PUBLIC_SITE_URL no está fijada).
# ALLOWED_INVITE_HOSTS=crm.convix.one,crm-staging.convix.one

# Secreto del cron de automatizaciones (GET /api/automations/cron).
# Requerido si usas pasos Wait. openssl rand -hex 32
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID — solo para plantillas con header de imagen.
# META_APP_ID=your-meta-app-id

# Versión del Graph API de Meta contra la que corren todas las
# llamadas de WhatsApp. Default: v25.0. Meta depreca versiones viejas
# con el tiempo — si un día deja de funcionar, probá bumpear esto
# antes de sospechar del código.
# META_API_VERSION=v25.0

# Modo dry-run de plantillas (CI / desarrollo sin WABA real).
# WHATSAPP_TEMPLATES_DRY_RUN=true

# Asistente de IA (BYOK; las claves se guardan cifradas en la BD).
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
